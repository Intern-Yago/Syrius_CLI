import React from 'react';
import styles from './styles.module.css';

/**
 * <%= props.name[0].toUpperCase() + props.name.substring(1) %> Component
 * Componente React funcional gerado com Syrius CLI
 */
export default function <%= props.name[0].toUpperCase() + props.name.substring(1) %>({
  title = '<%= props.name[0].toUpperCase() + props.name.substring(1) %>',
  children,
  className = '',
  ...props
}) {
  return (
    <section className={`${styles.container} ${className}`} {...props}>
      <div className={styles.header}>
        <h2 className={styles.title}>{title}</h2>
      </div>
      <div className={styles.content}>
        {children || <p><%= props.name %> está funcionando perfeitamente!</p>}
      </div>
    </section>
  );
}